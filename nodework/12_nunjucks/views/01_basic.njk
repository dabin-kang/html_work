<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>01_basic</title>
</head>
<body>
    {# 주석구간#}
    <h1>01_basic</h1>
            {% set aa = 10%}   {# 변수선언#}
            aa :{{aa}}</br>    {# 표현식#} 

            {% set bb = 20%}
            {% set aa = aa + bb%}
            aa : {{aa}} </br>

            {#연산#}
            {% set cc = 123%}
            {% set dd = 456%}
            cc+dd : {{cc+dd}}</br>

            {#조건#}
            {% set aa = 5%}
            {% if aa >= 10 %}
                aa 는 10 이상입니다.</br>
            {%elif aa >= 5%}
                aa 는 5~10 입니다.</br>    
            {%else%}
                aa 는 5 미만입니다.</br>
            {% endif %}


            {#반복#}
            {% set arr = ['정우성,'한가인','장동건'] %}            
            <ul>
                {% for ee in arr %}
                    <li>{{loop.index}} - {{ee}}</li>  {#loop.index  인덱스 번호 1번 부터 시작#}
                {% endfor %}
            </ul>    
    
</body>
</html>